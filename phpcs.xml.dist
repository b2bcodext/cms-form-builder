<?xml version="1.0"?>
<ruleset name="Package Coding Standard">
    <description>Oro coding standard (PSR2 + Oro custom sniffs).</description>

    <file>src</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/Resources/public/*</exclude-pattern>

    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="vendor/oro/platform/build/Oro/phpcs.xml">
        <!-- Pre-existing developer TODOs are content, not style: kept verbatim, sniff excluded. -->
        <exclude name="Generic.Commenting.Todo"/>
    </rule>
</ruleset>
